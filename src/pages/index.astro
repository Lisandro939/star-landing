---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ScrollingQuote from "../components/ScrollingQuote.astro";
import RealFor from "../components/RealFor.astro";
import Services from "../components/Services.astro";
import Plans from "../components/Plans.astro";
import About from "../components/About.astro";
import CallToAction from "../components/CallToAction.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Software a medida para empresas | Yzen Software"
  description="Desarrollamos software a medida, sistemas de gestión, páginas web y e-commerce para automatizar procesos y hacer crecer empresas en Mendoza y Argentina."
>
  <Navbar />

  <main class="bg-slate-950">
    <Hero />
    <ScrollingQuote />
    <RealFor />
    {/* Portfolio antes de Plans: prueba social antes de la venta (patrón Scale) */}
    <Services />
    <Plans />
    <About />
    <CallToAction />
    <Contact />
  </main>

  <Footer />
</Layout>
