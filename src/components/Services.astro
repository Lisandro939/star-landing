---
import { Icon } from 'astro-icon/components';
import efectosMendozaPc from '../assets/companies-examples/efectos-mendoza-pc.png';
import efectosMendozaMobile from '../assets/companies-examples/efectos-mendoza-mobile.png';
import esteticaAmapolaPc from '../assets/companies-examples/estetica-amapola-pc.png';
import esteticaAmapolaMobile from '../assets/companies-examples/estetica-amapola-mobile.png';
import puntoLunchPc from '../assets/companies-examples/punto-lunch-pc.png';
import puntoLunchMobile from '../assets/companies-examples/punto-lunch-mobile.png';
import deliveriesEnLavallePc from '../assets/companies-examples/deliveries-en-lavalle-pc.png';
import deliveriesEnLavalleMobile from '../assets/companies-examples/deliveries-en-lavalle-mobile.png';
import elBosquePc from '../assets/companies-examples/el-bosque-pc.png';
import elBosqueMobile from '../assets/companies-examples/el-bosque-mobile.png';
import brenatPc from '../assets/companies-examples/brenat-pc.png';
import brenatMobile from '../assets/companies-examples/brenat-mobile.png';
import dmleonPc from '../assets/companies-examples/dmleon-pc.png';
import dmleonMobile from '../assets/companies-examples/dmleon-mobile.png';

interface Project {
  id: number;
  title: string;
  url: string;
  imagePc: ImageMetadata;
  imageMobile: ImageMetadata;
}

const projects: Project[] = [
  { id: 1, title: 'Deliveries en Lavalle', url: 'https://www.deliveriesenlavalle.com.ar/', imagePc: deliveriesEnLavallePc, imageMobile: deliveriesEnLavalleMobile },
  { id: 2, title: 'Efectos Mendoza', url: 'https://mendoza-efectos.vercel.app/', imagePc: efectosMendozaPc, imageMobile: efectosMendozaMobile },
  { id: 3, title: 'Estética Amapola', url: 'https://amapola-estetica.vercel.app/', imagePc: esteticaAmapolaPc, imageMobile: esteticaAmapolaMobile },
  { id: 4, title: 'Punto Lunch', url: 'https://punto-lunch.vercel.app/', imagePc: puntoLunchPc, imageMobile: puntoLunchMobile },
  { id: 5, title: 'Caramelo', url: 'https://www.carameloclub.com/', imagePc: elBosquePc, imageMobile: elBosqueMobile },
  { id: 6, title: 'Brenat', url: 'https://www.brenat.com.ar/', imagePc: brenatPc, imageMobile: brenatMobile },
  { id: 7, title: 'DM León', url: 'https://www.dmleon.com.ar/', imagePc: dmleonPc, imageMobile: dmleonMobile },
];

// Slides cloned at both edges for seamless infinite loop: [last, ...all, first]
const slides = [projects[projects.length - 1], ...projects, projects[0]];

const pad = (n: number): string => String(n).padStart(2, '0');
---

<section
  class="theme-dark relative h-dvh overflow-hidden"
  id="servicios"
  data-nav-theme="dark"
  data-pin-section
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-cyan-900/10 rounded-full blur-[100px]"
      data-parallax="0.15"
    >
    </div>
  </div>

  <div class="relative z-10 flex h-full w-full flex-col justify-center py-16 md:py-20">
    <!-- Heading block -->
    <div class="container mx-auto mb-5 px-4 md:mb-8 md:px-6">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl">
          <p class="eyebrow mb-3 md:mb-4" data-reveal="fade">01 — Portfolio</p>
          <h2
            class="text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold tracking-[-0.03em] leading-[1.05] text-white"
            data-reveal="lines"
          >
            Nuestros <span class="text-cyan-300">Proyectos</span>
          </h2>
          <p
            class="mt-3 max-w-xl text-base text-slate-400 md:mt-4 md:text-lg"
            data-reveal="fade-up"
            data-reveal-delay="0.15"
          >
            Una colección de experiencias digitales diseñadas para impactar y
            escalar.
          </p>
        </div>
      </div>
    </div>

    <!-- Unified Infinite Carousel -->
    <div class="container mx-auto min-h-0 px-4 md:px-6">
      <div
        class="relative mx-auto max-w-7xl md:max-w-[min(80rem,calc((100dvh-22rem)*16/9))]"
        id="carousel"
        data-reveal="fade-up"
        data-reveal-delay="0.1"
      >
        <!-- Arrow Left -->
        <button
          id="carousel-prev"
          class="cursor-pointer absolute left-1 sm:left-2 md:-left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full border border-white/15 bg-slate-950/60 backdrop-blur-md flex items-center justify-center text-white/60 hover:text-white hover:border-white/40 transition-colors duration-300"
          aria-label="Proyecto anterior"
        >
          <Icon name="lucide:arrow-left" class="w-4 h-4 md:w-5 md:h-5" />
        </button>

        <!-- Arrow Right -->
        <button
          id="carousel-next"
          class="cursor-pointer absolute right-1 sm:right-2 md:-right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full border border-white/15 bg-slate-950/60 backdrop-blur-md flex items-center justify-center text-white/60 hover:text-white hover:border-white/40 transition-colors duration-300"
          aria-label="Proyecto siguiente"
        >
          <Icon name="lucide:arrow-right" class="w-4 h-4 md:w-5 md:h-5" />
        </button>

        <!-- Viewport: overflow visible para que las cards vecinas asomen (el clip lo hace la sección) -->
        <div class="!overflow-visible mx-8 md:mx-10">
          <div class="flex" id="carousel-track">
            {slides.map((project) => (
              <div class="w-full flex-shrink-0 px-2 md:px-4">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-project-link
                  class="group relative mx-auto block w-full max-w-[min(280px,30dvh)] overflow-clip rounded-xl border border-white/10 bg-slate-900/60 transition-all duration-500 ease-out-expo hover:border-cyan-300/40 hover:shadow-2xl hover:shadow-cyan-500/10 md:max-w-none"
                >
                  <!-- Mobile: tall vertical phone capture as protagonist. Desktop (md+): PC mockup aspect-video. -->
                  <div class="relative w-full aspect-[10/20] md:aspect-video bg-slate-900/50">
                    <!-- Mobile-only protagonist: vertical phone capture, full bleed -->
                    <img
                      src={project.imageMobile.src}
                      alt={`${project.title} — versión móvil`}
                      loading="lazy"
                      draggable="false"
                      class="md:hidden absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-100 select-none"
                    />

                    <!-- Desktop-only PC capture -->
                    <img
                      src={project.imagePc.src}
                      alt={`${project.title} — versión escritorio`}
                      loading="lazy"
                      draggable="false"
                      class="hidden md:block absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-100 select-none"
                    />

                    <!-- Desktop-only: mobile capture showcase overlay, bottom-right corner -->
                    <div class="hidden md:block absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-[30%] max-w-[170px] aspect-[10/20] rounded-xl overflow-hidden border border-white/10 shadow-2xl shadow-black/50 bg-slate-900 transition-transform duration-500 ease-out-expo group-hover:-translate-y-1">
                      <img
                        src={project.imageMobile.src}
                        alt={`${project.title} — versión móvil`}
                        loading="lazy"
                        draggable="false"
                        class="absolute inset-0 w-full h-full object-cover select-none"
                      />
                    </div>

                    <!-- Persistent overlay: mono badge + title, estilo Scale -->
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent p-4 md:p-6 pt-16 pointer-events-none">
                      <span class="font-mono text-[10px] font-medium uppercase tracking-[0.2em] text-cyan-300/90">
                        {pad(project.id)} — Web
                      </span>
                      <div class="mt-1.5 flex items-center gap-2">
                        <h3 class="text-white text-base md:text-xl font-semibold tracking-tight">
                          {project.title}
                        </h3>
                        <Icon
                          name="lucide:arrow-up-right"
                          class="w-4 h-4 text-cyan-300 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                        />
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Dots -->
        <div class="mt-4 flex flex-wrap justify-center gap-2 md:mt-6" id="carousel-dots">
          {projects.map((_, i) => (
            <button
              class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-cyan-300 w-8' : 'bg-white/20 w-1.5 hover:bg-white/40'}`}
              data-dot={i}
              aria-label={`Ir al proyecto ${i + 1}`}
            />
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Independent closing section: invitation to grow with the team -->
<section
  class="theme-dark relative flex h-dvh items-center overflow-hidden"
  data-nav-theme="dark"
  data-pin-section
  aria-labelledby="portfolio-cta-title"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/2 size-[clamp(22rem,55vw,48rem)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-500/[0.055] blur-[120px]"></div>
    <div class="absolute inset-x-[8%] top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
    <div class="absolute inset-x-[8%] bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
  </div>

  <div class="container relative z-10 mx-auto px-6">
    <div class="mx-auto max-w-5xl text-center">
        <p class="eyebrow mb-7" data-reveal="fade">Tu idea puede ser la siguiente</p>
        <h2
          id="portfolio-cta-title"
          class="text-[clamp(2.75rem,6vw,5.5rem)] font-bold leading-[1.02] tracking-[-0.04em] text-white"
          data-reveal="lines"
        >
          ¿Tu proyecto es el <span class="text-cyan-300">próximo</span>?<br />
          Crecé con nosotros.
        </h2>
        <p
          class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-slate-400 md:text-lg"
          data-reveal="fade-up"
          data-reveal-delay="0.15"
        >
          Sumate al equipo que convierte ideas en experiencias digitales que
          escalan.
        </p>
        <div class="mt-10" data-reveal="fade-up" data-reveal-delay="0.3">
          <a href="#contacto" class="btn-cta btn-cta--solid text-base">
            Hablemos de tu proyecto
            <span class="btn-arrows" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            </span>
          </a>
        </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track')!;
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  const prevBtn = document.getElementById('carousel-prev')!;
  const nextBtn = document.getElementById('carousel-next')!;
  const links = track.querySelectorAll<HTMLElement>('[data-project-link]');

  const realCount = dots.length; // number of actual projects
  // Track layout: [clone(last), 0, 1, ..., realCount-1, clone(first)]
  // Start on index 1 (first real project).
  let pos = 1;
  const TRANSITION = 'transform 500ms ease-out';

  function applyTransform(animate: boolean) {
    track.style.transition = animate ? TRANSITION : 'none';
    track.style.transform = `translateX(-${pos * 100}%)`;
  }

  function updateDots() {
    // Map carousel position back to a real project index.
    let real = pos - 1;
    if (real < 0) real = realCount - 1;
    if (real >= realCount) real = 0;
    dots.forEach((dot, i) => {
      dot.className = `h-1.5 rounded-full transition-all duration-300 ${
        i === real ? 'bg-cyan-300 w-8' : 'bg-white/20 w-1.5 hover:bg-white/40'
      }`;
    });
  }

  function go(delta: number) {
    pos += delta;
    applyTransform(true);
    updateDots();
  }

  function goToReal(realIndex: number) {
    pos = realIndex + 1;
    applyTransform(true);
    updateDots();
  }

  // Seamless wrap: when landing on a clone, jump instantly to the twin.
  track.addEventListener('transitionend', () => {
    if (pos === 0) {
      pos = realCount;
      applyTransform(false);
    } else if (pos === realCount + 1) {
      pos = 1;
      applyTransform(false);
    }
  });

  prevBtn.addEventListener('click', () => go(-1));
  nextBtn.addEventListener('click', () => go(1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goToReal(i)));

  // Touch / pointer drag with threshold + click guard.
  let startX = 0;
  let currentX = 0;
  let dragging = false;
  let moved = false;

  function onStart(clientX: number) {
    startX = clientX;
    currentX = clientX;
    dragging = true;
    moved = false;
    track.style.transition = 'none';
  }

  function onMove(clientX: number) {
    if (!dragging) return;
    currentX = clientX;
    const diff = currentX - startX;
    if (Math.abs(diff) > 5) moved = true;
    const offsetPct = (diff / track.clientWidth) * 100;
    track.style.transform = `translateX(calc(-${pos * 100}% + ${offsetPct}%))`;
  }

  function onEnd() {
    if (!dragging) return;
    dragging = false;
    const diff = currentX - startX;
    if (Math.abs(diff) > 50) {
      go(diff < 0 ? 1 : -1);
    } else {
      applyTransform(true);
    }
  }

  // Touch events
  track.addEventListener('touchstart', (e) => onStart(e.touches[0].clientX), { passive: true });
  track.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
  track.addEventListener('touchend', onEnd);

  // Mouse drag (desktop)
  track.addEventListener('mousedown', (e) => {
    e.preventDefault();
    onStart(e.clientX);
  });
  window.addEventListener('mousemove', (e) => onMove(e.clientX));
  window.addEventListener('mouseup', onEnd);

  // Prevent a drag from triggering navigation.
  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        moved = false;
      }
    });
  });

  // Initialize position without animation.
  applyTransform(false);
  updateDots();
</script>
