---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const menuItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Soluciones", href: "#soluciones" },
  { label: "Proyectos", href: "#servicios" },
  { label: "Planes", href: "#planes" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Empezá hoy", href: "#cta" },
];
---

<nav
  id="site-nav"
  class="fixed inset-x-0 top-3 z-50 md:top-4"
  aria-label="Navegación principal"
>
  <div class="container mx-auto px-4 md:px-6">
    <div
      class="nav-pill mx-auto flex h-12 items-center justify-between rounded-full border px-5 backdrop-blur-xl md:h-14 md:px-6"
    >
      <!-- LOGO: dos copias superpuestas, el swap lo hace CSS via [data-nav-theme] -->
      <a href="/" class="relative flex items-center" aria-label="Yzen Software — Inicio">
        <Image
          src="/assets/Yzen-Logo-With-Name-Color.png"
          alt="Yzen Software"
          width={96}
          height={32}
          class="nav-logo-color w-24"
        />
        <Image
          src="/assets/Yzen-Logo-With-Name-White.png"
          alt=""
          aria-hidden="true"
          width={96}
          height={32}
          class="nav-logo-white absolute top-0 left-0 w-24"
        />
      </a>

      <!-- DESKTOP MENU -->
      <div class="hidden items-center gap-3 lg:gap-5 xl:gap-6 md:flex">
        {
          menuItems.map((item) => (
            <a
              href={item.href}
              class="nav-link group/link relative py-2 text-[10px] font-bold tracking-wider uppercase lg:text-[11px] xl:text-xs"
            >
              {item.label}
              <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-cyan-500 transition-all duration-300 group-hover/link:w-full" />
            </a>
          ))
        }

        <a href="#contacto" class="btn-cta btn-cta--solid px-4 py-2 text-sm">
          Contacto
          <span class="btn-arrows" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </span>
        </a>
      </div>

      <!-- MOBILE MENU BUTTON -->
      <button
        class="nav-link relative z-[60] flex h-8 w-8 items-center justify-center md:hidden"
        id="menuToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenuPanel"
      >
        <span class="menu-icon-open">
          <Icon name="lucide:menu" size={24} />
        </span>
        <span class="menu-icon-close hidden">
          <Icon name="lucide:x" size={24} />
        </span>
      </button>
    </div>
  </div>
</nav>

<!-- MOBILE MENU OVERLAY -->
<div
  id="mobileMenuOverlay"
  class="pointer-events-none fixed inset-0 z-[55] bg-slate-950/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:hidden"
>
</div>

<!-- MOBILE MENU PANEL -->
<div
  id="mobileMenuPanel"
  class="fixed top-0 right-0 z-[56] h-full w-[280px] max-w-[85vw] translate-x-full border-l border-white/10 bg-slate-950/95 backdrop-blur-xl transition-transform duration-300 ease-out md:hidden"
>
  <div class="flex h-full flex-col px-6 pt-20 pb-8">
    <!-- MOBILE MENU LINKS -->
    <nav class="flex flex-col gap-2" aria-label="Menú mobile">
      {
        menuItems.map((item, index) => (
          <a
            href={item.href}
            class="mobile-menu-link group relative rounded-xl px-4 py-4 text-lg font-semibold text-slate-300 transition-all duration-300 hover:bg-white/5 hover:text-white"
            style={`--delay: ${index * 50}ms`}
          >
            <span class="relative z-10 flex items-center gap-3">
              <span class="h-1.5 w-1.5 rounded-full bg-cyan-500 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              {item.label}
            </span>
            <span class="absolute top-0 left-0 h-full w-1 rounded-full bg-gradient-to-b from-cyan-500 to-violet-500 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          </a>
        ))
      }
    </nav>

    <!-- MOBILE CTA BUTTON -->
    <div class="mt-auto border-t border-white/10 pt-6">
      <a
        href="#contacto"
        class="mobile-menu-link btn-cta btn-cta--solid w-full justify-center py-4 text-lg"
        style="--delay: 200ms"
      >
        Contacto
        <span class="btn-arrows" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
        </span>
      </a>
    </div>

    <!-- MOBILE MENU FOOTER -->
    <div class="mt-6 text-center text-sm text-slate-500">
      <p>© 2026 Yzen</p>
    </div>
  </div>
</div>

<style>
  /* Pill camaleón: las vars --nav-* las setea motion.ts via [data-nav-theme]
     en :root; el CSS de global.css define los valores por tema. */
  .nav-pill {
    background-color: var(--nav-bg);
    border-color: var(--nav-border);
    color: var(--nav-fg);
    transition:
      color 300ms var(--ease-out-expo),
      background-color 300ms var(--ease-out-expo),
      border-color 300ms var(--ease-out-expo);
  }

  .nav-link {
    color: var(--nav-fg);
    transition: color 300ms var(--ease-out-expo), opacity 200ms ease;
  }

  .nav-link:hover {
    opacity: 0.85;
  }

  /* Swap de logos por tema, solo CSS (sin JS). Default: tema dark → blanco. */
  .nav-logo-color,
  .nav-logo-white {
    transition: opacity 300ms var(--ease-out-expo);
  }

  .nav-logo-color {
    opacity: 0;
  }

  .nav-logo-white {
    opacity: 1;
  }

  #site-nav[data-nav-theme="light"] .nav-logo-color {
    opacity: 1;
  }

  #site-nav[data-nav-theme="light"] .nav-logo-white {
    opacity: 0;
  }

  .mobile-menu-link {
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
    transition-delay: var(--delay, 0ms);
  }

  #mobileMenuPanel.open .mobile-menu-link {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const mobileMenuOverlay = document.getElementById("mobileMenuOverlay");
  const mobileMenuPanel = document.getElementById("mobileMenuPanel");
  const menuIconOpen = menuToggle?.querySelector(".menu-icon-open");
  const menuIconClose = menuToggle?.querySelector(".menu-icon-close");
  const mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");

  let isMenuOpen = false;

  function openMenu(): void {
    isMenuOpen = true;
    mobileMenuOverlay?.classList.remove("opacity-0", "pointer-events-none");
    mobileMenuOverlay?.classList.add("opacity-100", "pointer-events-auto");
    mobileMenuPanel?.classList.remove("translate-x-full");
    mobileMenuPanel?.classList.add("translate-x-0", "open");
    menuIconOpen?.classList.add("hidden");
    menuIconClose?.classList.remove("hidden");
    menuToggle?.setAttribute("aria-expanded", "true");
    menuToggle?.setAttribute("aria-label", "Cerrar menú");
    document.body.style.overflow = "hidden";
  }

  function closeMenu(): void {
    isMenuOpen = false;
    mobileMenuOverlay?.classList.add("opacity-0", "pointer-events-none");
    mobileMenuOverlay?.classList.remove("opacity-100", "pointer-events-auto");
    mobileMenuPanel?.classList.add("translate-x-full");
    mobileMenuPanel?.classList.remove("translate-x-0", "open");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Abrir menú");
    document.body.style.overflow = "";
  }

  function toggleMenu(): void {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  menuToggle?.addEventListener("click", toggleMenu);
  mobileMenuOverlay?.addEventListener("click", closeMenu);

  mobileMenuLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen) {
      closeMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      closeMenu();
    }
  });
</script>
