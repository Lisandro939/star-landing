---
import { Icon } from "astro-icon/components";

const valores = [
  {
    icon: "lucide:rocket",
    title: "Velocidad",
    description: "Entregamos resultados rápidos sin sacrificar calidad.",
    fill: "#67e8f9",
  },
  {
    icon: "lucide:shield-check",
    title: "Seguridad",
    description:
      "Tu información siempre protegida con los más altos estándares.",
    fill: "#a5b4fc",
  },
  {
    icon: "lucide:headphones",
    title: "Soporte",
    description: "Estamos contigo en cada paso, antes y después de la entrega.",
    fill: "#7dd3fc",
  },
  {
    icon: "lucide:settings",
    title: "Personalización",
    description:
      "Cada solución se adapta 100% a las necesidades de tu negocio.",
    fill: "#c4b5fd",
  },
];
---

<section
  class="theme-light relative overflow-hidden py-10 sm:py-14 md:py-20"
  id="nosotros"
  data-nav-theme="light"
  data-pin-section
  data-pin-desktop
>
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="max-w-3xl mb-7 sm:mb-10 md:mb-14">
        <p class="eyebrow mb-4 md:mb-6" data-reveal="fade">03 — Nosotros</p>
        <h2
          class="text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold tracking-[-0.03em] leading-[1.05] text-slate-900"
          data-reveal="lines"
        >
          ¿Quiénes <span class="text-cyan-700">somos</span>?
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base md:mt-6 md:text-lg max-w-2xl"
          data-reveal="fade-up"
          data-reveal-delay="0.15"
        >
          Más de dos años construyendo software para negocios reales. Hablamos
          tu idioma y nos enfocamos en una sola cosa: que cada inversión
          digital se traduzca en resultados concretos.
        </p>
      </div>

      <!-- Values Grid -->
      <div
        class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6"
        data-reveal="stagger"
        data-reveal-stagger="0.1"
      >
        {
          valores.map((valor) => (
            <div
              class="value-card group relative isolate h-[17rem] overflow-hidden rounded-xl border border-transparent bg-slate-100 p-4 sm:h-[22rem] sm:rounded-2xl sm:p-6 lg:h-[25rem] lg:p-8"
              style={`--card-fill: ${valor.fill}`}
            >
              <span class="value-card__fill" aria-hidden="true"></span>
              <div class="value-card__content relative z-10 flex h-full flex-col">
              <div class="w-11 h-11 sm:w-14 sm:h-14 lg:w-16 lg:h-16 rounded-lg sm:rounded-xl bg-white border border-white flex items-center justify-center transition-all duration-700 group-hover:shadow-sm">
                <Icon
                  name={valor.icon}
                  class="text-cyan-700 transition-colors duration-500 group-hover:text-slate-900"
                  size={28}
                />
              </div>
              <h3 class="mt-10 text-lg font-display font-medium leading-tight text-slate-950 sm:mt-16 sm:text-xl lg:mt-20 lg:text-2xl">
                {valor.title}
              </h3>
              <p class="mt-auto pt-8 text-slate-700 text-xs sm:text-sm leading-relaxed">
                {valor.description}
              </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Stats Section -->
      <!-- <div
        class="mt-16 p-8 md:p-12 rounded-2xl bg-gradient-to-r from-slate-900/60 to-slate-900/40 border border-white/5"
      >
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              50+
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Proyectos entregados
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              98%
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Clientes satisfechos
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              48h
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Tiempo de respuesta
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              24/7
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Soporte disponible
            </p>
          </div>
        </div>
      </div> -->
    </div>
  </div>
</section>

<style>
  #nosotros {
    /* Gradientes estáticos: conservan la atmósfera sin rasterizar dos blurs
       gigantes en cada frame mientras la sección está pinneada. */
    background-image:
      radial-gradient(circle at 105% 18%, rgb(207 250 254 / 0.7), transparent 34rem),
      radial-gradient(circle at -8% 88%, rgb(224 231 255 / 0.65), transparent 32rem);
  }

  .value-card {
    transition:
      border-color 800ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .value-card__fill {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--card-fill);
    transform: translateY(100%);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .value-card__content,
  .value-card h3,
  .value-card p {
    transition: color 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .value-card:hover {
      border-color: transparent;
      box-shadow: 0 1.5rem 3.5rem -2rem color-mix(in srgb, var(--card-fill) 55%, transparent);
    }

    .value-card:hover .value-card__fill {
      transform: translateY(0);
    }

    .value-card:hover h3 {
      color: rgb(15 23 42);
    }

    .value-card:hover p {
      color: rgb(30 41 59);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card,
    .value-card__fill {
      transition-duration: 0.01ms;
    }
  }
</style>
