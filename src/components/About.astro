---
import { Icon } from "astro-icon/components";

const valores = [
  {
    icon: "lucide:rocket",
    title: "Velocidad",
    description: "Entregamos resultados rápidos sin sacrificar calidad.",
  },
  {
    icon: "lucide:shield-check",
    title: "Seguridad",
    description:
      "Tu información siempre protegida con los más altos estándares.",
  },
  {
    icon: "lucide:headphones",
    title: "Soporte",
    description: "Estamos contigo en cada paso, antes y después de la entrega.",
  },
  {
    icon: "lucide:settings",
    title: "Personalización",
    description:
      "Cada solución se adapta 100% a las necesidades de tu negocio.",
  },
];
---

<section
  class="theme-light relative overflow-hidden py-10 sm:py-14 md:py-20"
  id="nosotros"
  data-nav-theme="light"
  data-pin-section
>
  <!-- Background decorative elements -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-[5%] right-[-10%] w-[35%] h-[45%] bg-cyan-100/60 rounded-full blur-[120px]"
      data-parallax="0.15"
    >
    </div>
    <div
      class="absolute bottom-[10%] left-[-10%] w-[30%] h-[40%] bg-indigo-100/50 rounded-full blur-[110px]"
      data-parallax="0.1"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="max-w-3xl mb-7 sm:mb-10 md:mb-14">
        <p class="eyebrow mb-4 md:mb-6" data-reveal="fade">03 — Nosotros</p>
        <h2
          class="text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold tracking-[-0.03em] leading-[1.05] text-slate-900"
          data-reveal="lines"
        >
          ¿Quiénes <span class="text-cyan-700">somos</span>?
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base md:mt-6 md:text-lg max-w-2xl"
          data-reveal="fade-up"
          data-reveal-delay="0.15"
        >
          Más de dos años construyendo software para negocios reales. Hablamos
          tu idioma y nos enfocamos en una sola cosa: que cada inversión
          digital se traduzca en resultados concretos.
        </p>
      </div>

      <!-- Values Grid -->
      <div
        class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6"
        data-reveal="stagger"
        data-reveal-stagger="0.1"
      >
        {
          valores.map((valor) => (
            <div class="group relative h-full rounded-xl sm:rounded-2xl border border-slate-200 bg-white p-3.5 sm:p-5 lg:p-6 shadow-sm transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:border-cyan-700/30 hover:shadow-lg hover:shadow-slate-900/5">
              <div class="mb-3 w-10 h-10 sm:mb-4 sm:w-12 sm:h-12 lg:w-14 lg:h-14 rounded-lg sm:rounded-xl bg-cyan-50 border border-cyan-100 flex items-center justify-center transition-colors duration-300 group-hover:bg-cyan-100 group-hover:border-cyan-200">
                <Icon
                  name={valor.icon}
                  class="text-cyan-700 transition-colors"
                  size={28}
                />
              </div>
              <h3 class="text-base sm:text-lg lg:text-xl font-display font-semibold text-slate-900 mb-1.5 sm:mb-2">
                {valor.title}
              </h3>
              <p class="text-slate-600 text-[11px] sm:text-sm leading-relaxed">
                {valor.description}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Stats Section -->
      <!-- <div
        class="mt-16 p-8 md:p-12 rounded-2xl bg-gradient-to-r from-slate-900/60 to-slate-900/40 border border-white/5"
      >
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              50+
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Proyectos entregados
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              98%
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Clientes satisfechos
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              48h
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Tiempo de respuesta
            </p>
          </div>
          <div>
            <div
              class="text-4xl md:text-5xl font-display font-bold text-white mb-2"
            >
              24/7
            </div>
            <p class="text-slate-400 text-sm uppercase tracking-wider">
              Soporte disponible
            </p>
          </div>
        </div>
      </div> -->
    </div>
  </div>
</section>
