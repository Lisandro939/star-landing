---
import { Icon } from "astro-icon/components";
---

<section
  class="theme-dark relative overflow-hidden py-10 sm:py-14 md:py-20"
  id="contacto"
  data-nav-theme="dark"
  data-pin-section
>
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <p class="eyebrow mb-4 sm:mb-7" data-reveal="fade">05 — Contacto</p>

      <h2
        class="text-[clamp(2.5rem,6vw,5rem)] font-bold tracking-[-0.03em] leading-[1.05] text-white"
        data-reveal="lines"
      >
        ¿Listo para dar el <span class="text-cyan-300">gran salto</span>?
      </h2>

      <p
        class="mt-4 text-base sm:mt-7 sm:text-lg md:text-xl text-slate-400 leading-relaxed max-w-2xl mx-auto"
        data-reveal="fade-up"
        data-reveal-delay="0.15"
      >
        Estamos buscando el próximo gran desafío. Contanos sobre tu visión y
        nosotros ponemos la ingeniería para hacerla realidad.
      </p>

      <!-- WhatsApp CTA (verde de marca WhatsApp: excepción intencional al acento de sección) -->
      <div
        class="mt-7 sm:mt-10 md:mt-12 flex justify-center"
        data-reveal="fade-up"
        data-reveal-delay="0.3"
      >
        <a
          href="https://wa.me/5492615990250?text=¡Hola! Me gustaría obtener más información sobre sus servicios."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta btn-cta--solid gap-3 whitespace-nowrap px-4 py-4 text-base sm:gap-8 sm:px-9 sm:text-lg md:text-xl"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-7 md:h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
          </svg>
          Escribinos por WhatsApp
          <span class="btn-arrows" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </span>
        </a>
      </div>

      <!-- Social Links -->
      <div
        class="mt-8 sm:mt-12 md:mt-14 flex justify-center gap-5"
        data-reveal="fade-up"
        data-reveal-delay="0.4"
      >
        <a
          href="https://wa.me/5492615990250?text=¡Hola! Me gustaría obtener más información sobre sus servicios."
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 rounded-xl border border-white/10 bg-white/[0.03] flex items-center justify-center text-green-400 transition-all duration-300 ease-out-expo hover:border-green-400/30 hover:bg-green-500/10 hover:text-green-300 hover:-translate-y-1"
          aria-label="WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/yzen.software/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 rounded-xl border border-white/10 bg-white/[0.03] flex items-center justify-center text-pink-400 transition-all duration-300 ease-out-expo hover:border-pink-400/30 hover:bg-pink-500/10 hover:text-pink-300 hover:-translate-y-1"
          aria-label="Instagram"
        >
          <Icon name="lucide:instagram" size={26} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #contacto {
    /* Halos estáticos: evitan recalcular dos blurs grandes en cada frame. */
    background-image:
      radial-gradient(circle at 105% 92%, rgb(22 163 74 / 0.08), transparent 34rem),
      radial-gradient(circle at -5% 8%, rgb(8 145 178 / 0.08), transparent 28rem);
  }
</style>
