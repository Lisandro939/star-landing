---
// Full-bleed accent band estilo VideoCta de scale.com: tipografía gigante
// centrada sobre cyan-ink profundo, con grid + glow parallax de fondo.
---

<section
  class="theme-accent relative overflow-hidden py-12 sm:py-16 md:py-20"
  id="cta"
  data-nav-theme="dark"
  data-pin-section
>
  <!-- Decorative background: subtle grid + parallax glow -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 72px 72px;"
    >
    </div>
    <div
      class="absolute top-[-20%] left-1/2 -translate-x-1/2 w-[70%] h-[60%] bg-cyan-400/10 rounded-full blur-[140px]"
      data-parallax="0.2"
    >
    </div>
    <div
      class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-300/20 to-transparent"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-300/20 to-transparent"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Eyebrow -->
      <p class="eyebrow mb-7" data-reveal="fade">04 — Empezá hoy</p>

      <!-- Heading -->
      <h2
        class="text-[clamp(2.5rem,6vw,5rem)] font-bold tracking-[-0.03em] leading-[1.05] text-cyan-50"
        data-reveal="lines"
      >
        Tecnología compleja, <span class="text-cyan-300">precios simples</span>.
      </h2>

      <!-- Subtext -->
      <p
        class="mt-7 text-lg md:text-xl text-cyan-100/60 max-w-2xl mx-auto"
        data-reveal="fade-up"
        data-reveal-delay="0.15"
      >
        Nos ocupamos de toda la parte técnica para que vos solo te ocupes de
        vender.
      </p>

      <!-- CTA Buttons -->
      <div
        class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
        data-reveal="fade-up"
        data-reveal-delay="0.3"
      >
        <a href="#planes" class="btn-cta btn-cta--solid text-base">
          Ver Planes
          <span class="btn-arrows" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </span>
        </a>
        <a href="#contacto" class="btn-cta btn-cta--ghost text-base">
          Agenda una Demo
          <span class="btn-arrows" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
