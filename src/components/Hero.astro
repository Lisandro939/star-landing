---
import backgroundVideo from "../assets/background-video.mp4";
---

<section
  id="inicio"
  class="theme-dark relative h-[420svh] bg-white"
  data-nav-theme="dark"
>
  <div
    id="hero-pin"
    class="relative flex h-svh w-full items-center justify-center overflow-hidden px-5 pt-20 pb-5 sm:px-7 sm:pt-[5.5rem] sm:pb-7"
  >
    <div
      data-hero-background
      class="pointer-events-none absolute inset-0 bg-[#052E3E] opacity-0 will-change-opacity"
      aria-hidden="true"
    >
      <div class="accent-grid-pattern absolute inset-0 opacity-60"></div>
    </div>

    <div
      data-hero-frame
      class="hero-frame relative z-[3] h-full w-full max-w-[116.5rem] overflow-hidden rounded-[0.85rem] bg-slate-950 will-change-transform sm:rounded-[0.9rem]"
    >
      <video
        class="absolute inset-0 size-full object-cover"
        src={backgroundVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>

      <div class="hero-shade absolute inset-0" aria-hidden="true"></div>

      <div data-hero-copy class="relative z-10 flex h-full items-center justify-center px-5 py-20 text-center sm:px-10">
        <h1 class="max-w-[13ch] text-balance text-[clamp(2.4rem,7vw,7rem)] leading-[0.94] font-semibold tracking-[-0.055em] text-white">
          Hacé que tu empresa juegue en primera
        </h1>
      </div>
    </div>

    <div
      data-hero-caption
      class="pointer-events-none absolute inset-x-5 top-[72%] z-10 mx-auto max-w-2xl text-center text-white opacity-0 sm:inset-x-10"
    >
      <h2 class="text-balance text-[clamp(1.8rem,3.4vw,3.75rem)] leading-[1.02] font-semibold tracking-[-0.04em]">
        Tecnología que hace avanzar tu negocio.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-cyan-50/75 sm:text-base lg:text-lg">
        Creamos sistemas claros, potentes y hechos a medida para que tu empresa
        trabaje mejor y pueda crecer sin límites.
      </p>
    </div>

    <div
      data-hero-feature
      class="pointer-events-none absolute top-1/2 left-[9vw] z-10 w-[min(31rem,34vw)] -translate-y-1/2 text-white opacity-0 max-md:inset-x-6 max-md:top-auto max-md:bottom-[7svh] max-md:w-auto max-md:translate-y-0"
    >
      <p class="mb-7 flex items-center gap-2 text-[0.68rem] font-bold tracking-[0.16em] text-cyan-100/55 uppercase">
        <span class="size-2 rotate-45 border-t border-l border-cyan-100/60"></span>
        Soluciones
      </p>
      <h2 class="max-w-[12ch] text-balance text-[clamp(2rem,3.3vw,4rem)] leading-[0.98] font-semibold tracking-[-0.045em]">
        Sistemas que realmente funcionan.
      </h2>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-cyan-50/70 lg:text-base">
        Encontramos la solución adecuada, construimos el sistema y acompañamos
        cada etapa para que la tecnología genere resultados reales.
      </p>
      <span class="mt-8 inline-flex items-center gap-8 rounded-lg bg-cyan-50 px-5 py-3 text-sm font-semibold text-[#052E3E]">
        Conocé nuestras soluciones
        <span aria-hidden="true">→</span>
      </span>
    </div>

    <div data-hero-scroll-cue class="pointer-events-none absolute right-9 bottom-10 z-10 flex size-11 items-center justify-center rounded-lg border border-white/80 text-white md:hidden" aria-hidden="true">
      <span class="text-xl leading-none">↓</span>
    </div>

    <div
      data-hero-data
      class="pointer-events-none absolute top-1/2 right-[9vw] z-10 w-[min(31rem,34vw)] -translate-y-1/2 text-white opacity-0 max-md:inset-x-6 max-md:top-auto max-md:bottom-[7svh] max-md:w-auto max-md:translate-y-0"
    >
      <p class="mb-7 flex items-center gap-2 text-[0.68rem] font-bold tracking-[0.16em] text-cyan-100/55 uppercase">
        <span class="size-2 rotate-45 border-t border-l border-cyan-100/60"></span>
        Datos
      </p>
      <h2 class="max-w-[13ch] text-balance text-[clamp(2rem,3.3vw,4rem)] leading-[0.98] font-semibold tracking-[-0.045em]">
        La información que impulsa mejores decisiones.
      </h2>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-cyan-50/70 lg:text-base">
        Convertimos los datos de tu empresa en información clara para que puedas
        anticiparte, decidir con confianza y crecer con una estrategia sólida.
      </p>
      <span class="mt-8 inline-flex items-center gap-8 rounded-lg bg-cyan-50 px-5 py-3 text-sm font-semibold text-[#052E3E]">
        Potenciá tus datos
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero-frame {
    box-shadow: 0 24px 70px -36px rgb(15 23 42 / 0.55);
    contain: layout paint;
    backface-visibility: hidden;
    will-change: transform, clip-path;
  }

  .hero-frame video {
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  .hero-shade {
    background:
      linear-gradient(180deg, rgb(2 6 23 / 0.2), rgb(2 6 23 / 0.08) 42%, rgb(2 6 23 / 0.32)),
      radial-gradient(circle at center, transparent 15%, rgb(2 6 23 / 0.2) 100%);
  }

  @media (max-width: 767px) {
    #inicio {
      height: 400svh;
    }

    #hero-pin {
      padding: 5.75rem 1rem 1rem;
      background: #fff;
    }

    .hero-frame {
      border-radius: 0.9rem;
    }

    [data-hero-copy] {
      padding-inline: 1.1rem;
    }

    [data-hero-copy] h1 {
      max-width: 14ch;
      font-size: clamp(2rem, 9.5vw, 3.05rem);
      line-height: 1.06;
      letter-spacing: -0.052em;
    }

    [data-hero-caption],
    [data-hero-feature],
    [data-hero-data] {
      inset-inline: 1.4rem;
      width: auto;
      text-align: center;
    }

    [data-hero-caption] {
      top: 57%;
    }

    [data-hero-feature],
    [data-hero-data] {
      bottom: 10svh;
    }

    [data-hero-caption] h2,
    [data-hero-feature] h2,
    [data-hero-data] h2 {
      margin-inline: auto;
      max-width: 17ch;
      font-size: clamp(1.75rem, 7.5vw, 2.35rem);
      line-height: 1.08;
      letter-spacing: -0.045em;
    }

    [data-hero-caption] p,
    [data-hero-feature] > p:not(:first-child),
    [data-hero-data] > p:not(:first-child) {
      margin: 1rem auto 0;
      max-width: 31rem;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    [data-hero-feature] > p:first-child,
    [data-hero-data] > p:first-child {
      justify-content: center;
      margin-bottom: 1.8rem;
    }

    [data-hero-feature] > span,
    [data-hero-data] > span {
      margin-top: 1.6rem;
      border-radius: 0.55rem;
      padding: 0.9rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #inicio {
      height: auto;
      background: #052e3e;
    }

    #hero-pin {
      min-height: 100svh;
    }

    [data-hero-frame] {
      height: min(52svh, 38rem);
      width: min(82vw, 62rem);
      transform: translateY(-12svh) perspective(1200px) rotateX(3deg) rotateY(-16deg);
    }

    [data-hero-copy] {
      display: none;
    }

    [data-hero-caption] {
      display: none;
    }

    [data-hero-feature] {
      display: none;
    }

    [data-hero-data] {
      opacity: 1;
    }
  }
</style>
