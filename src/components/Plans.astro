---
import { Icon } from "astro-icon/components";

interface Plan {
  name: string;
  description: string;
  features: string[];
  ctaText: string;
  ctaHref: string;
  isPopular?: boolean;
  isPrimary?: boolean;
  isPersonalized?: boolean;
}

const plans: Plan[] = [
  {
    name: "PÁGINA WEB",
    description: "Ideal para emprendedores y startups",
    features: [
      "Diseño moderno y adaptable",
      "Secciones personalizadas",
      "Formulario de contacto",
      "Optimización SEO avanzada",
      "Entrega en 48 horas",
    ],
    ctaText: "Comenzar",
    ctaHref:
      "https://wa.me/5492615990250?text=¡Hola!%20Me%20gustaría%20saber%20más%20sobre%20el%20desarrollo%20de%20una%20página%20web.",
    isPopular: false,
    isPrimary: false,
    isPersonalized: false,
  },
  {
    name: "SISTEMA DE GESTIÓN",
    description: "Para negocios en crecimiento",
    features: [
      "Control de inventario y movimientos de stock",
      "Alertas de productos con stock bajo",
      "Registro de ventas, ingresos y gastos",
      "Reportes de ventas, stock y rendimiento",
      "Generación de presupuestos, comprobantes y documentos",
      "Mantenimiento, actualizaciones y soporte técnico",
    ],
    ctaText: "Comenzar",
    ctaHref:
      "https://wa.me/5492615990250?text=¡Hola!%20Me%20interesaría%20obtener%20más%20información%20sobre%20un%20sistema%20de%20gestión.",
    isPopular: true,
    isPrimary: true,
    isPersonalized: false,
  },
  {
    name: "E-COMMERCE",
    description: "Vendé tus productos las 24 horas, desde cualquier lugar",
    features: [
      "Catálogo de productos y categorías",
      "Carrito de compras y gestión de pedidos",
      "Integración con Mercado Pago",
      "Control de stock en tiempo real",
      "Gestión de clientes y ventas",
      "Cupones, promociones y descuentos",
      "Panel autogestionable",
      "Reportes de ventas y productos más vendidos",
      "Diseño adaptable a celulares y computadoras",
      "Mantenimiento y soporte técnico",
    ],
    ctaText: "Comenzar",
    ctaHref:
      "https://wa.me/5492615990250?text=¡Hola!%20Quiero%20consultar%20sobre%20el%20desarrollo%20de%20un%20e-commerce.",
    isPopular: false,
    isPrimary: false,
    isPersonalized: false,
  },
  {
    name: "SISTEMA PERSONALIZADO",
    description: "Nos adaptamos a tu necesidad",
    features: [
      "E-commerce",
      "Turneros y reservas automatizadas",
      "Plataformas educativas",
      "Generadores de documentos",
      "Cotizadores automáticos",
      "Portales de autogestión de clientes",
    ],
    ctaText: "Quiero un presupuesto",
    ctaHref:
      "https://wa.me/5492615990250?text=¡Hola!%20Me%20gustaría%20cotizar%20un%20sistema%20personalizado%20a%20medida.",
    isPopular: false,
    isPrimary: false,
    isPersonalized: true,
  },
];
---

<section
  class="theme-dark plans-section relative overflow-hidden py-16 sm:py-20 lg:h-dvh lg:py-0"
  id="planes"
  data-nav-theme="dark"
  data-pin-section
  data-pin-desktop
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Subtle grid texture for depth -->
    <div
      class="absolute inset-0 opacity-[0.035]"
      style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 64px 64px;"
    >
    </div>
  </div>

  <div class="plans-shell container mx-auto px-4 sm:px-6 relative z-10 lg:flex lg:h-full lg:items-center">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="plans-header max-w-3xl mb-10 sm:mb-14">
        <p class="plans-eyebrow eyebrow mb-4 sm:mb-6" data-reveal="fade">02 — Planes</p>
        <h2
          class="plans-title text-[clamp(2.25rem,10vw,4.5rem)] font-bold tracking-[-0.035em] leading-[1.05] text-white"
          data-reveal="lines"
        >
          Planes que <span class="text-cyan-300">escalan contigo</span>
        </h2>
        <p
          class="plans-intro mt-4 text-base leading-relaxed text-slate-400 sm:mt-6 sm:text-lg max-w-xl"
          data-reveal="fade-up"
          data-reveal-delay="0.15"
        >
          Elige el plan perfecto para tu negocio. Sin costos ocultos.
        </p>
      </div>

      <!-- Plans Grid -->
      <div
        class="plans-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 lg:gap-6 items-stretch"
        data-reveal="stagger"
        data-reveal-stagger="0.1"
      >
        {
          plans.map((plan) => (
            <div
              class={`plan-card relative group rounded-[1.25rem] sm:rounded-3xl p-px lg:transition-transform lg:duration-300 lg:ease-out-expo lg:hover:-translate-y-1 ${
                plan.isPrimary
                  ? "bg-gradient-to-b from-cyan-400/70 via-cyan-500/25 to-transparent lg:-mt-4 lg:mb-4 shadow-lg shadow-cyan-500/15"
                  : plan.isPersonalized
                    ? "bg-gradient-to-b from-indigo-400/40 via-violet-500/15 to-transparent hover:from-indigo-400/60"
                    : "bg-gradient-to-b from-white/20 to-white/[0.04] hover:from-white/35"
              }`}
            >
              {/* Popular Badge */}
              {plan.isPopular && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-20">
                  <div class="px-4 py-1.5 rounded-full bg-cyan-300 text-slate-950 font-mono text-[10px] font-semibold uppercase tracking-[0.2em] shadow-lg shadow-cyan-500/40">
                    Más popular
                  </div>
                </div>
              )}

              {/* Card */}
              <div
                class={`plan-card__inner relative h-full p-5 sm:p-7 lg:p-6 rounded-[calc(1.25rem-1px)] sm:rounded-[calc(1.5rem-1px)] flex flex-col overflow-hidden lg:transition-colors lg:duration-300 ${
                  plan.isPrimary
                    ? "bg-slate-900"
                    : "bg-slate-900 group-hover:bg-slate-900"
                }`}
              >
                {/* Inner top glow for featured / personalized */}
                {(plan.isPrimary || plan.isPersonalized) && (
                  <div
                    class={`absolute -top-px left-1/2 -translate-x-1/2 w-3/4 h-px ${
                      plan.isPrimary
                        ? "bg-gradient-to-r from-transparent via-cyan-300/70 to-transparent"
                        : "bg-gradient-to-r from-transparent via-violet-300/60 to-transparent"
                    }`}
                  />
                )}

                {/* Plan Header */}
                <div class="plan-card__header mb-6 sm:mb-8">
                  <h3
                    class={`font-display font-semibold mb-4 break-words leading-tight ${
                      plan.isPersonalized
                        ? "text-2xl text-transparent bg-clip-text bg-gradient-to-r from-violet-200 to-indigo-200"
                        : plan.isPrimary
                          ? "text-xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-100 to-cyan-300"
                          : "text-xl text-white"
                    }`}
                  >
                    {plan.name}
                  </h3>
                  <p class="text-slate-400 text-sm mt-3 leading-relaxed">
                    {plan.description}
                  </p>
                </div>

                {/* Features List */}
                <ul class="plan-features space-y-3 mb-7 sm:space-y-3.5 sm:mb-8 flex-grow">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <span
                        class={`mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full ${
                          plan.isPersonalized
                            ? "bg-violet-500/15 text-violet-300"
                            : "bg-cyan-500/15 text-cyan-300"
                        }`}
                      >
                        <Icon name="lucide:check" size={12} />
                      </span>
                      <span class="text-slate-300 text-sm leading-relaxed">
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>

                {/* CTA Button */}
                <a
                  href={plan.ctaHref}
                  target={
                    plan.ctaHref.startsWith("http") ? "_blank" : undefined
                  }
                  rel={
                    plan.ctaHref.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                  class={`btn-cta w-full justify-center text-sm ${
                    plan.isPrimary ? "btn-cta--solid" : "btn-cta--ghost"
                  }`}
                >
                  {plan.ctaText}
                  <span class="btn-arrows" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                  </span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .plans-section {
    background-image:
      radial-gradient(circle at 92% 18%, rgba(8, 145, 178, 0.14), transparent 30rem),
      radial-gradient(circle at 5% 88%, rgba(79, 70, 229, 0.12), transparent 28rem);
  }

  .plan-card {
    /* El badge sobresale de la card; paint containment lo recortaba. */
    contain: layout;
  }

  /* Desktop: toda la escena, incluidas las cards, vive dentro de un viewport. */
  @media (min-width: 1024px) {
    .plans-shell > div {
      width: 100%;
    }

    .plans-header {
      margin-bottom: clamp(1.5rem, 3.2dvh, 3rem);
    }

    .plans-eyebrow {
      margin-bottom: clamp(0.5rem, 1.5dvh, 1.25rem);
    }

    .plans-title {
      font-size: clamp(2.5rem, min(4.5vw, 6.8dvh), 4.5rem);
    }

    .plans-intro {
      margin-top: clamp(0.5rem, 1.4dvh, 1.25rem);
      font-size: clamp(0.875rem, 1.7dvh, 1.125rem);
    }

    .plans-grid {
      gap: clamp(0.75rem, 1.4vw, 1.5rem);
    }

    .plan-card__inner {
      padding: clamp(1rem, 2dvh, 1.5rem);
    }

    .plan-card__header {
      margin-bottom: clamp(0.75rem, 1.8dvh, 1.5rem);
    }

    .plan-card__header h3 {
      margin-bottom: clamp(0.35rem, 0.8dvh, 0.75rem);
      font-size: clamp(1rem, 2.1dvh, 1.25rem);
    }

    .plan-card__header p,
    .plan-features span:last-child {
      font-size: clamp(0.7rem, 1.45dvh, 0.875rem);
      line-height: 1.45;
    }

    .plan-features {
      margin-bottom: clamp(0.75rem, 1.8dvh, 1.5rem);
      row-gap: clamp(0.35rem, 0.9dvh, 0.75rem);
    }

    .plan-features li {
      gap: clamp(0.45rem, 0.7vw, 0.75rem);
    }

    .plan-features li > span:first-child {
      width: clamp(1rem, 2dvh, 1.25rem);
      height: clamp(1rem, 2dvh, 1.25rem);
    }

    .plan-card .btn-cta {
      min-height: clamp(2.25rem, 4.8dvh, 3rem);
      padding-block: clamp(0.45rem, 1dvh, 0.75rem);
    }
  }

  @media (max-width: 767px) {
    .plans-section {
      background-image:
        radial-gradient(circle at 100% 10%, rgba(8, 145, 178, 0.12), transparent 18rem),
        radial-gradient(circle at 0% 92%, rgba(79, 70, 229, 0.1), transparent 18rem);
    }
  }
</style>
